# Ensure all .ahk files are treated as text and use LF line endings
*.ahk text eol=lf

# Ensure shell scripts use LF line endings
*.sh text eol=lf

# Ensure batch files use CRLF line endings (Windows compatibility)
*.bat text eol=crlf

# Ensure markdown files use LF line endings
*.md text eol=lf

# Ensure JSON files use LF line endings
*.json text eol=lf

# Ensure no line endings are changed for binary files
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary